# Set explicitly in production. Relative paths resolve from the repository root.
PROTEGER_DB_PATH=database/proteger.db
PROTEGER_C_LIBRARY=core_engine/build/libscanner.so
PROTEGER_TEMP_DIR=/tmp

# Comma-separated exact browser origins. Keep the localhost defaults for local development.
PROTEGER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PROTEGER_MAX_FILE_BYTES=10485760
PROTEGER_MAX_ARCHIVE_BYTES=20971520
PROTEGER_MAX_ARCHIVE_MEMBER_BYTES=5242880
PROTEGER_MAX_ARCHIVE_ENTRIES=100
PROTEGER_MAX_ARCHIVE_DEPTH=2
PROTEGER_FINDINGS_PAGE_SIZE=50
